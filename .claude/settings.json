{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); if printf '%s' \"$cmd\" | grep -qE '(^|[;&|] *)git commit'; then { npm run lint -- --max-warnings 0 && npm run typecheck; } >&2 || { echo '❌ Lint or typecheck failed — fix before committing.' >&2; exit 2; }; fi"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "hakan-devteam": {
      "source": {
        "source": "github",
        "repo": "hakanappelgren/claude-devteam"
      }
    }
  },
  "enabledPlugins": {
    "devteam@hakan-devteam": true,
    "sales@knowledge-work-plugins": false,
    "legal@knowledge-work-plugins": false,
    "marketing@knowledge-work-plugins": false,
    "brand-voice@knowledge-work-plugins": false,
    "slack-by-salesforce@knowledge-work-plugins": false,
    "product-management@knowledge-work-plugins": false,
    "pdf-viewer@knowledge-work-plugins": false
  }
}
